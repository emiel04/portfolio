---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
	limit?: number;
}

const { limit } = Astro.props;
const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const shown = limit ? posts.slice(0, limit) : posts;
---

<ul class="post-list -mx-3 -mt-3.5">
	{
		shown.map((post) => (
			<li data-reveal>
				<a
					href={`/blog/${post.id}/`}
					class="post-row group flex items-baseline justify-between gap-6 rounded-lg px-3 py-3.5"
				>
					<span class="text-fg">{post.data.title}</span>
					<span class="text-faint shrink-0 font-mono text-xs">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</a>
			</li>
		))
	}
</ul>

{
	limit && posts.length > limit && (
		<a href="/blog/" class="link mt-6 inline-block text-sm">
			All {posts.length} posts
		</a>
	)
}

<style>
	.post-row {
		transition: background-color 150ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.post-row:hover {
			background: var(--color-surface);
		}
	}
	.post-row:active {
		background: var(--color-surface);
	}
	@media (max-width: 480px) {
		.post-row {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
