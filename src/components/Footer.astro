---
import { LINKEDIN_URL, GITHUB_URL } from "../consts";
const year = new Date().getFullYear();
---

<footer class="container-page">
	<div
		class="border-line text-faint flex flex-col gap-4 border-t py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
	>
		<p>&copy; {year} Emiel Delaey</p>
		<ul class="flex gap-5">
			<li>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="footer-link"
					>LinkedIn</a
				>
			</li>
			<li>
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a
				>
			</li>
			<li>
				<a href="https://v1.emield.be" target="_blank" rel="noopener noreferrer" class="footer-link"
					>Old version</a
				>
			</li>
		</ul>
	</div>
</footer>

<style>
	.footer-link {
		transition: color 150ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.footer-link:hover {
			color: var(--color-fg);
		}
	}
</style>
