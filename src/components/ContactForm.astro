---
import { LINKEDIN_URL } from "../consts";
---

<p data-reveal class="text-muted max-w-[52ch] text-lg leading-relaxed">
	Do you have a question, or do you want to work together? Send me a message here, or find me on
	<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a>.
</p>

<form id="contact-form" data-reveal class="mt-8 space-y-4">
	<input type="hidden" name="access_key" value="6a025050-4e00-468b-b3b8-4afe13db92ff" />
	<input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

	<div class="grid gap-4 sm:grid-cols-2">
		<label class="block">
			<span class="text-muted mb-2 block text-sm">Name</span>
			<input type="text" name="name" required autocomplete="name" class="field" />
		</label>
		<label class="block">
			<span class="text-muted mb-2 block text-sm">Email</span>
			<input type="email" name="email" required autocomplete="email" class="field" />
		</label>
	</div>
	<label class="block">
		<span class="text-muted mb-2 block text-sm">Message</span>
		<textarea name="message" rows="5" required class="field resize-y"></textarea>
	</label>

	<div class="flex flex-wrap items-center gap-4 pt-2">
		<button type="submit" class="btn btn-primary">Send message</button>
		<p id="form-status" class="text-muted text-sm" role="status" aria-live="polite"></p>
	</div>
</form>

<style>
	.field {
		display: block;
		width: 100%;
		padding: 0.75rem 0.875rem;
		border-radius: 0.625rem;
		border: 1px solid var(--color-line-strong);
		background: var(--color-surface);
		color: var(--color-fg);
		font-size: 1rem;
		transition:
			border-color 150ms ease,
			box-shadow 150ms ease;
	}
	.field:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px rgb(96 165 250 / 0.2);
	}
	button[disabled] {
		opacity: 0.6;
		pointer-events: none;
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement;
	const status = document.getElementById("form-status")!;
	const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

	const setStatus = (text: string, color: string) => {
		status.textContent = text;
		status.style.color = color;
	};

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		submit.disabled = true;
		setStatus("Sending...", "var(--color-muted)");

		try {
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(Object.fromEntries(new FormData(form))),
			});
			const json = await response.json();

			if (response.ok) {
				setStatus("Thanks! I'll get back to you soon.", "var(--color-live)");
				form.reset();
			} else {
				setStatus(json.message ?? "Something went wrong. Please try again.", "#f87171");
			}
		} catch {
			setStatus("Something went wrong. Please try again.", "#f87171");
		} finally {
			submit.disabled = false;
		}
	});
</script>
