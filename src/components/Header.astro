---
const isHome = Astro.url.pathname === "/";
const links = [
	{ id: "about", label: "About" },
	{ id: "stack", label: "Stack" },
	{ id: "work", label: "Work" },
	{ id: "writing", label: "Writing" },
	{ id: "contact", label: "Contact" },
];
const hrefFor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header data-header class="site-header sticky top-0 z-50">
	<nav class="container-page flex h-16 items-center justify-between" aria-label="Main">
		<a href="/" class="font-display text-fg text-[15px] font-semibold"> Emiel Delaey </a>

		<ul class="hidden items-center gap-1 md:flex">
			{
				links.map((link) => (
					<li>
						<a href={hrefFor(link.id)} data-nav={link.id} class="nav-link">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<button
			type="button"
			data-menu-button
			class="menu-button md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			Menu
			<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path
					d="M4 6l4 4 4-4"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>

		<div id="mobile-menu" data-menu class="mobile-menu md:hidden">
			{
				links.map((link) => (
					<a href={hrefFor(link.id)} data-nav={link.id}>
						{link.label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<style>
	.site-header {
		border-bottom: 1px solid transparent;
		transition:
			background-color 200ms ease,
			border-color 200ms ease;
	}
	.site-header[data-scrolled] {
		background: rgb(9 9 11 / 0.72);
		border-bottom-color: var(--color-line);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
	}

	.nav-link {
		display: block;
		padding: 0.375rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
		transition: color 150ms ease;
	}
	.nav-link[data-active] {
		color: var(--color-fg);
	}
	@media (hover: hover) and (pointer: fine) {
		.nav-link:hover {
			color: var(--color-fg);
		}
	}

	.menu-button {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding-inline: 0.875rem;
		border-radius: 0.625rem;
		border: 1px solid var(--color-line-strong);
		font-size: 0.875rem;
		color: var(--color-fg);
		transition: transform 160ms var(--ease-out);
	}
	.menu-button:active {
		transform: scale(0.97);
	}
	.menu-button svg {
		transition: transform 200ms var(--ease-out);
	}
	.site-header[data-open] .menu-button svg {
		transform: rotate(180deg);
	}

	.mobile-menu {
		position: absolute;
		top: 3.75rem;
		right: 1.25rem;
		width: 12rem;
		padding: 0.375rem;
		border-radius: 0.875rem;
		border: 1px solid var(--color-line-strong);
		background: var(--color-surface);
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
		transform-origin: top right;
		opacity: 0;
		transform: scale(0.96) translateY(-4px);
		visibility: hidden;
		transition:
			opacity 120ms ease,
			transform 120ms var(--ease-out),
			visibility 0s linear 120ms;
	}
	.site-header[data-open] .mobile-menu {
		opacity: 1;
		transform: none;
		visibility: visible;
		transition:
			opacity 180ms ease,
			transform 200ms var(--ease-out),
			visibility 0s;
	}
	@media (min-width: 768px) {
		.menu-button,
		.mobile-menu {
			display: none;
		}
	}
	.mobile-menu a {
		display: block;
		padding: 0.625rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.9375rem;
		color: var(--color-muted);
	}
	.mobile-menu a:active,
	.mobile-menu a[data-active] {
		background: var(--color-surface-2);
		color: var(--color-fg);
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>("[data-header]")!;
	const button = header.querySelector<HTMLButtonElement>("[data-menu-button]")!;
	const menu = header.querySelector<HTMLElement>("[data-menu]")!;

	const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
	onScroll();
	window.addEventListener("scroll", onScroll, { passive: true });

	const setOpen = (open: boolean) => {
		header.toggleAttribute("data-open", open);
		button.setAttribute("aria-expanded", String(open));
	};
	button.addEventListener("click", (event) => {
		event.stopPropagation();
		setOpen(!header.hasAttribute("data-open"));
	});
	document.addEventListener("click", (event) => {
		if (!menu.contains(event.target as Node)) setOpen(false);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && header.hasAttribute("data-open")) {
			setOpen(false);
			button.focus();
		}
	});
	menu
		.querySelectorAll("a")
		.forEach((link) => link.addEventListener("click", () => setOpen(false)));

	// Highlight the section that is currently in the middle of the screen
	const navLinks = header.querySelectorAll<HTMLElement>("[data-nav]");
	const sections = [...new Set([...navLinks].map((link) => link.dataset.nav!))]
		.map((id) => document.getElementById(id))
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length > 0) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					navLinks.forEach((link) =>
						link.toggleAttribute("data-active", link.dataset.nav === entry.target.id),
					);
				}
			},
			{ rootMargin: "-45% 0px -50% 0px" },
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>
