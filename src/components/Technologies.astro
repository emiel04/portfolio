---
import { Icon } from "astro-icon/components";

const daily = [
	{ name: "Laravel", icon: "laravel" },
	{ name: "PHP", icon: "php" },
];

const groups = [
	{
		name: "I've also worked with",
		items: [
			{ name: "Go", icon: "go" },
			{ name: "TypeScript", icon: "ts" },
			{ name: "JavaScript", icon: "javascript" },
			{ name: "Vue", icon: "vue" },
			{ name: "React", icon: "react" },
			{ name: "Node.js", icon: "nodejs" },
			{ name: "Java", icon: "java" },
			{ name: "Spring", icon: "spring" },
			{ name: "C#", icon: "cs" },
			{ name: ".NET", icon: "net" },
			{ name: "Deno", icon: "deno" },
			{ name: "RabbitMQ", icon: "rabbitmq" },
			{ name: "Tailwind CSS", icon: "tailwindcss" },
			{ name: "HTML", icon: "html" },
			{ name: "CSS", icon: "css" },
			{ name: "WordPress", icon: "wordpress" },
		],
	},
	{
		name: "Databases and tools",
		items: [
			{ name: "MySQL", icon: "mysql" },
			{ name: "PostgreSQL", icon: "postgresql" },
			{ name: "Docker", icon: "docker" },
			{ name: "Git", icon: "git" },
			{ name: "GitLab", icon: "gitlab" },
			{ name: "VS Code", icon: "vscode" },
		],
	},
];
---

<div class="space-y-10" data-spotlight>
	<div data-reveal>
		<h3 class="text-muted mb-4 text-sm">What I use every day</h3>
		<ul class="grid grid-cols-2 gap-2 sm:gap-3">
			{
				daily.map((tech) => (
					<li class="glow border-line bg-surface flex flex-col items-start gap-2.5 rounded-xl border p-3.5 sm:flex-row sm:items-center sm:gap-3 sm:px-4">
						<Icon name={tech.icon} class="size-6 shrink-0" />
						<span class="text-fg font-medium">{tech.name}</span>
					</li>
				))
			}
		</ul>
	</div>

	{
		groups.map((group) => (
			<div data-reveal>
				<h3 class="text-muted mb-4 text-sm">{group.name}</h3>
				<ul class="flex flex-wrap gap-2">
					{group.items.map((tech) => (
						<li class="glow border-line text-muted flex items-center gap-2 rounded-lg border px-2.5 py-1.5 text-sm">
							<Icon name={tech.icon} class="size-4 shrink-0" />
							{tech.name}
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>

<style>
	.glow {
		position: relative;
		isolation: isolate;
	}
	.glow::before,
	.glow::after {
		content: "";
		position: absolute;
		border-radius: inherit;
		pointer-events: none;
		opacity: 0;
		transition: opacity 300ms ease;
	}
	/* Light on the border, only near the cursor */
	.glow::before {
		inset: -1px;
		padding: 1px;
		background: radial-gradient(
			130px circle at var(--x, -999px) var(--y, -999px),
			rgb(96 165 250 / 0.75),
			transparent 70%
		);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
	}
	/* Soft light inside the chip */
	.glow::after {
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			180px circle at var(--x, -999px) var(--y, -999px),
			rgb(96 165 250 / 0.1),
			transparent 70%
		);
	}
	[data-spotlight][data-active] .glow::before,
	[data-spotlight][data-active] .glow::after {
		opacity: 1;
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-spotlight]");
	const hasMouse = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (root && hasMouse) {
		const items = [...root.querySelectorAll<HTMLElement>(".glow")];
		const target = { x: 0, y: 0 };
		const current = { x: 0, y: 0 };
		let frame = 0;

		const paint = () => {
			// Ease towards the cursor so the light trails a little instead of sticking to it
			const ease = reduceMotion ? 1 : 0.2;
			current.x += (target.x - current.x) * ease;
			current.y += (target.y - current.y) * ease;

			// Read every position first, then write, so the browser only lays out once
			const rects = items.map((item) => item.getBoundingClientRect());
			items.forEach((item, i) => {
				item.style.setProperty("--x", `${current.x - rects[i].left}px`);
				item.style.setProperty("--y", `${current.y - rects[i].top}px`);
			});

			const moving = Math.abs(target.x - current.x) > 0.5 || Math.abs(target.y - current.y) > 0.5;
			frame = moving ? requestAnimationFrame(paint) : 0;
		};

		const request = () => {
			if (!frame) frame = requestAnimationFrame(paint);
		};

		root.addEventListener("pointerenter", (event) => {
			target.x = current.x = event.clientX;
			target.y = current.y = event.clientY;
			root.setAttribute("data-active", "");
			request();
		});
		root.addEventListener("pointermove", (event) => {
			target.x = event.clientX;
			target.y = event.clientY;
			request();
		});
		root.addEventListener("pointerleave", () => root.removeAttribute("data-active"));
		window.addEventListener("scroll", () => root.hasAttribute("data-active") && request(), {
			passive: true,
		});
	}
</script>
