---
const main = [
	{
		title: "Full-stack developer",
		company: "BrightAnalytics",
		period: "Sep 2025 - now",
		current: true,
		description:
			"I work on a financial reporting and consolidation platform, mostly in Laravel and sometimes in Go. I build features from start to finish, work on integrations with other software, help with framework upgrades, and help the team write better tests.",
	},
	{
		title: "Software engineer intern",
		company: "Citymesh",
		period: "Feb - May 2025",
		current: false,
		description:
			"I built a tool that turns 5G use cases into reports with charts. I talked with the business side to find out what they needed, led our sprints, and built a small multi-service tool with Node.js, Kafka and Vue.",
	},
];

const earlier = [
	{
		title: "Technical support",
		company: "Citymesh",
		period: "Jul 2024",
		description: "Helped customers on site and remotely, and set up WiFi hardware.",
	},
	{
		title: "Customer service",
		company: "La Belgique Gourmande",
		period: "Aug 2023",
		description: "Sold local specialty products and helped customers.",
	},
	{
		title: "Website developer",
		company: "Knoware",
		period: "Jul 2022",
		description: "Built a new WordPress website and used Jira to plan the work.",
	},
	{
		title: "Software engineer intern",
		company: "City of Oostkamp",
		period: "Apr 2022",
		description: "Built a web app with ASP.NET that collects data from schools automatically.",
	},
];
---

<ol class="space-y-10">
	{
		main.map((job) => (
			<li data-reveal class="grid gap-1.5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
				<p class="text-faint font-mono text-xs sm:pt-1.5">{job.period}</p>
				<div>
					<h3 class="font-display text-fg text-lg font-semibold tracking-[-0.01em]">
						{job.title}
						<span class="text-muted font-normal">
							at <span class="text-accent">{job.company}</span>
						</span>
						{job.current && (
							<span class="border-line text-muted ml-1.5 inline-flex translate-y-[-2px] items-center gap-1.5 rounded-full border px-2 py-0.5 align-middle font-mono text-[11px] font-normal">
								<span class="bg-accent size-1.5 rounded-full" aria-hidden="true" />
								Now
							</span>
						)}
					</h3>
					<p class="text-muted mt-2 max-w-[60ch] leading-relaxed">{job.description}</p>
				</div>
			</li>
		))
	}
</ol>

<h3 data-reveal class="text-muted mt-14 mb-5 text-sm">Earlier</h3>
<ol class="divide-line border-line divide-y border-y">
	{
		earlier.map((job) => (
			<li data-reveal class="grid gap-1 py-4 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
				<p class="text-faint font-mono text-xs sm:pt-1">{job.period}</p>
				<div>
					<p class="text-fg text-[15px]">
						{job.title}{" "}
						<span class="text-muted">
							at <span class="text-accent">{job.company}</span>
						</span>
					</p>
					<p class="text-faint mt-1 text-sm">{job.description}</p>
				</div>
			</li>
		))
	}
</ol>
