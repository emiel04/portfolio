---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import Technologies from "../components/Technologies.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import BlogList from "../components/BlogList.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN_URL, GITHUB_URL } from "../consts";

const CV_URL = "/files/CV-Emiel-Delaey.pdf";

const facts = [
	{ label: "Based in", value: "Bruges, Belgium" },
	{ label: "Studied", value: "Applied Computer Science at Howest" },
	{ label: "Languages", value: "Dutch (native), English (fluent)" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main id="main">
			<section class="relative -mt-16 overflow-hidden pt-16">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="hero-grid" aria-hidden="true"></div>

				<div class="container-page relative pt-20 pb-20 sm:pt-32 sm:pb-24 md:pt-40 md:pb-28">
					<h1
						class="enter font-display max-w-[17ch] text-[clamp(2.5rem,7.2vw,4.75rem)] leading-[1.03] font-semibold tracking-[-0.03em] text-balance"
						style="--i: 0"
					>
						Hi, I'm Emiel.<span class="wave" role="img" aria-label="waving hand">👋</span><br />
						<span class="text-blue">I build software, mostly the parts you don't see.</span>
					</h1>

					<p
						class="enter text-muted mt-6 max-w-[54ch] text-lg leading-relaxed sm:text-xl sm:leading-relaxed"
						style="--i: 1"
					>
						Full-stack developer at <span class="text-fg">BrightAnalytics</span>, working on a
						financial reporting platform with Laravel and Go, where the numbers always have to be
						right.
					</p>

					<div class="enter mt-9 flex flex-wrap gap-3" style="--i: 2">
						<a href={CV_URL} download class="btn btn-primary">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							Download CV
						</a>
						<a
							href={LINKEDIN_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-ghost max-sm:w-10 max-sm:justify-center max-sm:px-0"
						>
							<svg
								class="size-4 shrink-0"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"
								></path>
							</svg>
							<span class="max-sm:sr-only">LinkedIn</span>
						</a>
						<a
							href={GITHUB_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-ghost max-sm:w-10 max-sm:justify-center max-sm:px-0"
						>
							<svg
								class="size-4 shrink-0"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"
								></path>
							</svg>
							<span class="max-sm:sr-only">GitHub</span>
						</a>
					</div>

					<p
						class="enter text-faint mt-12 flex items-center gap-2 font-mono text-xs"
						style="--i: 3"
					>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0z"
								stroke="currentColor"
								stroke-width="2"></path>
							<circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"></circle>
						</svg>
						Bruges, Belgium
						<span data-clock hidden>
							<span aria-hidden="true">·</span>
							<time></time> local time
						</span>
					</p>
				</div>
			</section>

			<Section id="about" label="About">
				<div class="text-muted max-w-[60ch] space-y-5 text-lg leading-relaxed">
					<p data-reveal>
						I studied Applied Computer Science at Howest in Bruges. After my internship at Citymesh,
						I started at <span class="text-fg">BrightAnalytics</span>, where I've now worked for a
						year.
					</p>
					<p data-reveal>
						Most of my time goes to the backend, but I like to build a feature from start to finish,
						from the database to the screen. I care about code that the next person can read, and
						tests that catch problems before users do.
					</p>
					<p data-reveal>
						Outside of work I like to self-host things and try out new tools. Sometimes I
						<a href="#writing" class="link">write about it</a>.
					</p>
				</div>

				<dl
					data-reveal
					class="border-line bg-line mt-10 grid max-w-[60ch] gap-px overflow-hidden rounded-xl border"
				>
					{
						facts.map((fact) => (
							<div class="bg-bg grid gap-1 px-4 py-3 sm:grid-cols-[7rem_1fr] sm:gap-4">
								<dt class="text-faint font-mono text-xs sm:pt-1">{fact.label}</dt>
								<dd class="text-fg text-[15px]">{fact.value}</dd>
							</div>
						))
					}
				</dl>
			</Section>

			<Section id="stack" label="Stack">
				<Technologies />
			</Section>

			<Section id="work" label="Work">
				<ExperienceTimeline />
				<p data-reveal class="mt-8">
					<a href={CV_URL} download class="link text-sm">Download my full CV (PDF)</a>
				</p>
			</Section>

			<Section id="writing" label="Writing">
				<BlogList limit={4} />
			</Section>

			<Section id="contact" label="Contact">
				<ContactForm />
			</Section>
		</main>

		<Footer />

		<script>
			const clock = document.querySelector<HTMLElement>("[data-clock]");
			const time = clock?.querySelector("time");

			if (clock && time) {
				const format = new Intl.DateTimeFormat("en-GB", {
					hour: "2-digit",
					minute: "2-digit",
					timeZone: "Europe/Brussels",
				});
				const tick = () => {
					time.textContent = format.format(new Date());
				};
				tick();
				clock.hidden = false;
				setInterval(tick, 15_000);
			}
		</script>
	</body>
</html>
