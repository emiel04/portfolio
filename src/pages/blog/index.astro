---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogList from "../../components/BlogList.astro";
import { SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Writing - ${SITE_TITLE}`}
			description="Notes about things I built, events I went to, and what I learned."
		/>
	</head>
	<body>
		<Header />
		<main id="main" class="container-page">
			<div class="mx-auto max-w-[44rem] pt-12 pb-24 md:pt-20">
				<h1 class="font-display text-4xl font-semibold tracking-[-0.02em]">Writing</h1>
				<p class="text-muted mt-3 text-lg">
					Notes about things I built, events I went to, and what I learned.
				</p>
				<div class="mt-10">
					<BlogList />
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
